MONGO_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/test
PORT=5000
JWT_SECRET=your_jwt_secret_key_here

# Email OTP Configuration (Nodemailer)
# Resend (preferred)
RESEND_API_KEY=your_resend_api_key
EMAIL_FROM=onboarding@resend.dev

# SMTP (Brevo/Mailgun/SendGrid SMTP)
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=your_smtp_user
SMTP_PASS=your_smtp_password
SMTP_SECURE=false

# Gmail SMTP fallback (not recommended for production)
EMAIL_USER=your_email@gmail.com
EMAIL_APP_PASSWORD=your_app_password
GMAIL_SMTP_HOST=smtp.gmail.com
GMAIL_SMTP_PORT=465
GMAIL_SMTP_SECURE=true

# Optional email tuning
EMAIL_SEND_TIMEOUT_MS=15000
EMAIL_RETRY_LIMIT=1

# AWS Configuration
AWS_ACCESS_KEY_ID=your_aws_access_key
AWS_SECRET_ACCESS_KEY=your_aws_secret_key
AWS_REGION=ap-south-1
AWS_BUCKET_NAME=your_bucket_name
